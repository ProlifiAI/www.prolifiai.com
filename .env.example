# Public site URL, used for canonical URLs, Open Graph, sitemap and robots.
# Defaults to https://www.prolifiai.com (the canonical domain) when unset. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.prolifiai.com

# ---- Project enquiry delivery (server-side only, never exposed to the browser) ----
# The contact form posts to /api/contact, which sends every enquiry to info@prolifiai.com
# (fixed in src/content/site.ts as `enquiryEmail`) through Resend (https://resend.com).
# Without these values:
#   - in development the enquiry is logged to the server console and the form says it was NOT delivered
#   - in production the endpoint returns 503 and the form shows an error (plus the fallback email, if set)
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Prolifi Website <website@prolifiai.com>"
CONTACT_FROM_EMAIL=

# Optional public address shown on the contact page and when delivery fails. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: Google Search Console HTML-tag verification token (the content="..." value only).
# Not needed if you verify the Domain property with a DNS TXT record, which is recommended.
GOOGLE_SITE_VERIFICATION=
